node_modules/
out/
*.vsix
!releases/*.vsix
.vscode-test/
.DS_Store
.env
__pycache__/
*.py[cod]

# Agent harness config — local-only, never committed and never shipped.
# The suite this extension ships lives in resources/skills/ and is the only
# skill set it distributes (docs/plans/grokbit-actions-and-bundled-skill-suite.md
# § D4). These two directories are ALSO the provisioning target for that suite
# at the home tier, so a workspace copy here is always a local override.
# Both are excluded from the vsix by .vscodeignore as well.
.claude/
.grok/

# Environment & secrets
.env.*
!.env.example
*.pem
*.key

# Dependencies / build output (adjust for your stack)
dist/
build/
.venv/
target/

# Editor / tooling backups. The agentic-template installer writes
# `<file>.bak-agentic-*` / `AGENTS.md.bak-before-agentic-template-*` copies on
# every run; git history is the backup, so they never belong in a commit.
# `.grokbit/**/snapshots/` is the one deliberate exception — those .bak files
# are a plan's recorded before-state, not installer collateral.
*.bak
*.bak-*
*.orig
*~
!.grokbit/plans/**/snapshots/*

# Shell-redirect artifacts. A PowerShell `2>$null` / `mkdir -p` run through the
# wrong shell creates a literal `$null` file (or `nul` on cmd) in the repo root
# instead of discarding output — both have been committed here before.
$null
nul

# Scratch space for temp copies of tracked files (a `.tmp-workflow/ci.yml`
# stash of the real CI workflow was committed and then went stale).
.tmp-workflow/
